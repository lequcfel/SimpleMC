{
	"bundle": {
		"createUpdaterArtifacts": true,
		"windows": {
			"nsis": {
				"template": "nsis/SimpleMC-installer.nsi",
				"installerIcon": "icons/icon.ico",
				"sidebarImage": "nsis/SimpleMC-background.bmp"
			}
		},
		"targets": [
			"nsis"
		],
		"resources": {
			"../../LICENSE": "LICENSE.txt",
			"../../NOTICE.md": "NOTICE.md"
		}
	},
	"build": {
		"features": [
			"updater"
		],
		"beforeBuildCommand": "pnpm --filter @modrinth/app-frontend exec vite build"
	},
	"app": {
		"security": {
			"capabilities": [
				"core",
				"plugins",
				"updater"
			]
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBOUIxNkRGRDZFNUM2QzMKUldURHh1WFczeGFiT25RcC9mZi9qbUVIck5SYnVOREQ0MTc3enU2MGJ0S0dkZmI1RWV0TWJFTnUK",
			"endpoints": [
				"https://github.com/lequcfel/SimpleMC/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "quiet"
			}
		}
	},
	"identifier": "com.simplemc.launcher",
	"version": "../app-frontend/package.json"
}
