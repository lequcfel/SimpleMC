<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="SimpleMC Setup" Width="900" Height="560" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" Foreground="White">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#34363E"/>
			<Setter Property="BorderBrush" Value="#50535F"/><Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="20,11"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
				<Border x:Name="Frame" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
					<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<ControlTemplate.Triggers>
					<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger>
					<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
					<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
				</ControlTemplate.Triggers>
			</ControlTemplate></Setter.Value></Setter>
		</Style>
	</Window.Resources>
	<Grid x:Name="Root"><Grid.Clip><RectangleGeometry Rect="0,0,900,560" RadiusX="18" RadiusY="18"/></Grid.Clip>
		<Image x:Name="Landscape" Stretch="UniformToFill" Opacity="0.65"><Image.Effect><BlurEffect Radius="8"/></Image.Effect></Image>
		<Border Background="#99101116"/>
		<Grid>
			<Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
			<Grid x:Name="TitleBar" Background="Transparent" Margin="20,0,12,0">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="Logo" Width="27" Height="27"/><TextBlock Text="SimpleMC" FontWeight="Bold" FontSize="17" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<Button x:Name="Minimize" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Padding="13,10"><Path Data="M 0,5 L 12,5" Stroke="White" StrokeThickness="1.5" Width="12" Height="12"/></Button>
					<Button x:Name="Close" ToolTip="Close" Background="Transparent" BorderThickness="0" Padding="13,10"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="White" StrokeThickness="1.5" Width="12" Height="12"/></Button>
				</StackPanel>
			</Grid>
			<Grid Grid.Row="1" Margin="22,6,22,22">
				<Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
				<Border Background="#E6101116" CornerRadius="14" Padding="16,22">
					<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
						<TextBlock Text="CLIENT" Foreground="#A8AAB3" FontSize="11" FontWeight="Bold" Margin="10,0,0,12"/>
						<Border Grid.Row="1" Background="#263B82F6" BorderBrush="#664287F5" BorderThickness="1" CornerRadius="8" Padding="12"><TextBlock Text="Installation" FontWeight="SemiBold" FontSize="14"/></Border>
						<StackPanel Grid.Row="3" Margin="10,0,0,0"><TextBlock Text="SimpleMC __VERSION__" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Windows - 64-bit" Foreground="#A8AAB3" FontSize="12" Margin="0,5,0,0"/><Button x:Name="Licenses" Content="About / Licenses" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" FontSize="12" HorizontalAlignment="Left"/></StackPanel>
					</Grid>
				</Border>
				<Border Grid.Column="2" Background="#E6101116" CornerRadius="14" Padding="28">
					<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
						<TextBlock x:Name="Heading" Text="Install SimpleMC" FontSize="27" FontWeight="Bold"/>
						<TextBlock x:Name="Description" Grid.Row="1" Text="Your Minecraft client, ready in a few clicks." Foreground="#B7BAC5" FontSize="14" TextWrapping="Wrap" Margin="0,9,0,26"/>
						<StackPanel Grid.Row="2">
							<TextBlock Text="Installation folder" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
							<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border CornerRadius="8" Background="#25272E" BorderBrush="#42454F" BorderThickness="1" Padding="12"><TextBox x:Name="Location" Background="Transparent" Foreground="#D5D7DF" BorderThickness="0" FontSize="13"/></Border><Button x:Name="Browse" Grid.Column="1" Content="Browse..." Margin="10,0,0,0" Padding="15,10"/></Grid>
							<TextBlock x:Name="Note" Text="Repair keeps your profiles and settings. During uninstall, you can choose whether to keep your data." Foreground="#969BA9" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
							<CheckBox x:Name="DesktopShortcut" Content="Create a desktop shortcut" IsChecked="True" Foreground="White" FontSize="13" Margin="0,16,0,0"/>
						</StackPanel>
						<StackPanel Grid.Row="4">
							<TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="13" Foreground="#B7BAC5" Margin="0,0,0,12"/>
							<ProgressBar x:Name="Progress" Height="5" Foreground="#21D970" Background="#30343C" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,18"/>
							<Border x:Name="Confirmation" Background="#25272E" CornerRadius="8" Padding="14" Visibility="Collapsed" Margin="0,0,0,14">
								<StackPanel><TextBlock Text="Uninstall SimpleMC?" FontWeight="SemiBold"/><TextBlock Text="Keep your data, or choose a complete removal." TextWrapping="Wrap" Foreground="#B7BAC5" Margin="0,6,0,10"/><CheckBox x:Name="RemoveData" Content="Also remove profiles, worlds, settings and saved data" Foreground="White" FontSize="12" Margin="0,0,0,10"/><TextBlock x:Name="RemovalDetails" TextWrapping="Wrap" Foreground="#FFADB5" FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/><StackPanel Orientation="Horizontal"><Button x:Name="ConfirmUninstall" Content="Uninstall" Background="#C63C49" BorderThickness="0"/><Button x:Name="CancelUninstall" Content="Cancel" Margin="10,0,0,0"/></StackPanel></StackPanel>
							</Border>
							<StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right">
								<Button x:Name="Uninstall" Content="Uninstall" Foreground="#FFADB5" BorderBrush="#76515B" Background="#332329" Margin="0,0,10,0" Visibility="Collapsed"/>
								<Button x:Name="Primary" Content="Install" Background="#21D970" Foreground="#061A0F" BorderThickness="0" MinWidth="145"/>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>
